{%- comment -%}
  Waiter24 chat widget — app embed block.
  Merchant enables it under Theme editor → App embeds and pastes the public
  Widget Key from the Waiter24 dashboard. Loads the same widget.js used by the
  WordPress plugin and the marketing site.
{%- endcomment -%}

{%- if block.settings.widget_key != blank -%}
  <script
    defer
    src="{{ block.settings.widget_url | escape }}"
    data-key="{{ block.settings.widget_key | strip | escape }}"
    {%- if block.settings.demo_mode %} data-demo-param="waiter24_demo"{% endif -%}
  ></script>
{%- endif -%}

{% schema %}
{
  "name": "Waiter24 Chat",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "widget_key",
      "label": "Widget Key",
      "info": "Copy from your Waiter24 dashboard (Site Integration)."
    },
    {
      "type": "text",
      "id": "widget_url",
      "label": "Widget script URL",
      "default": "https://waiter24.ai/widget.js"
    },
    {
      "type": "checkbox",
      "id": "demo_mode",
      "label": "Demo mode",
      "default": false,
      "info": "When on, the chat stays hidden for regular visitors and appears only on URLs that carry the ?waiter24_demo=1 parameter. Preview it by opening your storefront with that parameter, e.g. https://your-store.myshopify.com/?waiter24_demo=1 — the parameter is remembered for the session and re-applied to in-chat links."
    }
  ]
}
{% endschema %}
